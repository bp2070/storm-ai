{
  "name": "storm-ai",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsx build.ts",
    "start": "dotenvx run -- node dist/index.js",
    "dev": "tsx build.ts && dotenvx run -- node dist/index.js",
    "clean": "rm -rf dist data/storm.db data/current_session logs/*.log",
